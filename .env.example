# MongoDB Atlas connection string (URL-encode special characters in username/password)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=hikarixd

# Optional server-wide API key (ditampilkan di menu API Key); if empty, generated/stored in MongoDB
API_KEY=

# Optional third-party provider gateway
# External provider credentials belong in server environment variables, not source code.
# Optional per-provider overrides. Example for terabox/sechno:
# EXTERNAL_PROVIDER_TERABOX_SECHNO_URL=https://provider.example/api
# EXTERNAL_PROVIDER_TERABOX_SECHNO_KEY=
